# ---------------------------------------------------------------------------
# Variables d'environnement
# ---------------------------------------------------------------------------
# En développement local (`pnpm dev`) : copier ce fichier vers `.env.local`.
# Pour `pnpm preview` / `pnpm deploy` (workerd) : copier les valeurs non
# secrètes dans `wrangler.jsonc` (clé "vars") et pousser les secrets avec
# `wrangler secret put <NOM>` (ou les placer dans `.dev.vars` en local).
# ---------------------------------------------------------------------------

# URL publique de l'application (sans barre oblique finale).
APP_URL="http://localhost:3000"

# Secret de signature des sessions Better Auth.
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-32-chars-minimum-please"

# Envoi d'e-mails.
#   console = les messages sont écrits dans la console (développement)
#   resend  = envoi réel via l'API Resend (RESEND_API_KEY obligatoire)
MAIL_DRIVER="console"
MAIL_FROM="Invitations <no-reply@example.com>"
RESEND_API_KEY=""

# Domaine (ou route Worker) servant les photos stockées dans R2.
R2_PUBLIC_BASE_URL="http://localhost:3000/api/photos"

# Liste d'e-mails administrateurs, séparés par des virgules.
ADMIN_EMAILS="moi@example.com"

# ---------------------------------------------------------------------------
# Informations légales (mentions légales, CGV, politique de confidentialité).
# Facultatif : toute variable absente laisse son placeholder `[[...]]`
# clairement visible sur les pages /legal/* tant qu'elle n'est pas renseignée.
# ---------------------------------------------------------------------------
LEGAL_COMPANY_NAME="[[COMPANY_NAME]]"
LEGAL_COMPANY_FORM="[[LEGAL_FORM]]"
LEGAL_COMPANY_ADDRESS="[[COMPANY_ADDRESS]]"
LEGAL_SIREN="[[SIREN]]"
LEGAL_VAT_NUMBER="[[VAT_NUMBER]]"
LEGAL_PUBLICATION_DIRECTOR="[[PUBLICATION_DIRECTOR]]"
LEGAL_CONTACT_EMAIL="[[CONTACT_EMAIL]]"
LEGAL_DPO_EMAIL="[[DPO_EMAIL]]"
