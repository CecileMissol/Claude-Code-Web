{
  "name": "invitations-web",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply invitations-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply invitations-db --remote"
  },
  "dependencies": {
    "@fontsource/allura": "5.3.0",
    "@fontsource/bodoni-moda": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/mrs-saint-delafield": "5.3.0",
    "@fontsource/pinyon-script": "5.3.0",
    "@opennextjs/cloudflare": "1.20.6",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "gsap": "^3.15.0",
    "next": "16.3.5",
    "next-intl": "4.14.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.28.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "5.0.1",
    "wrangler": "4.136.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "unrs-resolver",
      "workerd",
      "sharp"
    ]
  }
}
